{
  "name": "front-end-navigation",
  "version": "1.5.2",
  "description": "Chrome extensions for front-end development.",
  "main": "index.js",
  "scripts": {
    "lint": "eslint --ext js --ext vue ./src ./config --fix && stylelint \"./src/**/*.vue\" --fix",
    "dev": "cross-env NODE_ENV=development webpack serve",
    "analysis": "cross-env NODE_ENV=analysis webpack --progress",
    "build": "rimraf ./dist && cross-env NODE_ENV=production webpack --progress",
    "build:chrome": "rimraf ./chrome-extends/* && cp ./google-extends-manifest.json ./chrome-extends/manifest.json && cross-env NODE_ENV=chrome webpack --progress",
    "test": "cross-env NODE_ENV=chrome BABEL_ENV=test karma start test/unit/karma.conf.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hengliyin/front-end-navigation.git"
  },
  "author": "hengliyin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hengliyin/front-end-navigation/issues"
  },
  "homepage": "https://github.com/hengliyin/front-end-navigation#readme",
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "element-ui": "^2.15.14",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "rimraf": "^6.0.1",
    "stylelint-webpack-plugin": "^5.0.1",
    "vue": "^2.7.16",
    "vue-loader": "^15.11.1",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@vue/test-utils": "^1.3.6",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.0",
    "chai": "^5.1.2",
    "coveralls": "^3.1.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "ejs": "^3.1.10",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.31.0",
    "file-loader": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-mocha": "^2.0.1",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-spec-reporter": "0.0.36",
    "karma-webpack": "^5.0.1",
    "mocha": "^10.8.2",
    "postcss-html": "^1.8.0",
    "postcss-loader": "^8.1.1",
    "sass": "^1.82.0",
    "sass-loader": "^16.0.3",
    "style-loader": "^4.0.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "url-loader": "^4.1.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.16",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
